{
  "name": "chat-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm env:load tsx watch src/server.ts",
    "db:studio": "pnpm env:load prisma studio",
    "env:load": "dotenv -e .env --",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api web",
    "docker:seed": "docker compose exec api pnpm prisma db seed",
    "test": "vitest run --config src/test/vitest.config.ts",
    "test:watch": "vitest --config src/test/vitest.config.ts",
    "docker:test": "docker compose exec api pnpm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "6.5.0",
    "@tsconfig/node22": "^22.0.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.0.2",
    "nodemailer": "7.0.5",
    "sharp": "0.34.2",
    "socket.io": "^4.8.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "1.4.12",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.3",
    "prisma": "^6.10.1",
    "supertest": "7.1.1",
    "typescript": "^5.8.3",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@9.15.9"
}
